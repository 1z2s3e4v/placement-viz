+// DRCU_VIO_DUMP: one CSV row per violation counted by printAllVio (same loops, same helper functions),
+// plus the MIN_AREA_VIO events counted since the last routeStat.clear(). Counts that printAllVio halves
+// (wire-wire spacing, same-layer via-via) are emitted with a running carry so that the per-layer row
+// count equals floor(sum / 2) exactly; each row sits at the violating end of the segment / at the via.
+void RouteGrid::dumpAllVio(const char* path) const {
+    std::ofstream ofs(path);
+    ofs << "type,layer,xl,yl,xh,yh\n";
+    std::map<std::string, int> rows;
+    auto emit = [&](const char* type, const std::string& layer, const utils::BoxT<DBU>& b, int n = 1) {
+        for (int k = 0; k < n; ++k)
+            ofs << type << ',' << layer << ',' << b.x.low << ',' << b.y.low << ',' << b.x.high << ',' << b.y.high
+                << '\n';
+        rows[type] += n;
+    };
+    auto wireBox = [&](int l, int t, int lo, int hi) {
+        const auto& layer = layers[l];
+        lo = std::max(0, std::min(lo, layer.numCrossPoints() - 1));
+        hi = std::max(0, std::min(hi, layer.numCrossPoints() - 1));
+        BoxOnLayer box = layer.getLoc(GridBoxOnLayer(l, {t, t}, {std::min(lo, hi), std::max(lo, hi)}));
+        box.x.low -= layer.width / 2, box.y.low -= layer.width / 2, box.x.high += layer.width / 2, box.y.high += layer.width / 2;
+        return box;
+    };
+    for (int l = 0; l < getLayerNum(); ++l) {
+        const std::string& name = getLayer(l).name;
+        int spaceAcc = 0;
+        for (int t = 0; t < layers[l].numTracks(); ++t) {
+            for (const auto& intvlUsage : routedWireMap[l][t]) {
+                const auto& intvl = intvlUsage.first;
+                int usage = intvlUsage.second.size();
+                if (usage > 1) emit("short_ww", name, wireBox(l, t, first(intvl), last(intvl)), usage - 1);
+                iteratePoorWireSegments({l, t, {first(intvl), last(intvl)}},
+                                        *intvlUsage.second.begin(),
+                                        [&](const utils::IntervalT<int>& poorIntvl) {
+                                            emit("short_wf", name, wireBox(l, t, poorIntvl.low, poorIntvl.high));
+                                        });
+                for (int netIdx : intvlUsage.second) {
+                    auto vioCPs = getWireSegmentSpaceVioOnWires({l, t, {first(intvl), last(intvl)}}, netIdx);
+                    if (vioCPs.empty()) continue;
+                    int n = (spaceAcc + int(vioCPs.size())) / 2 - spaceAcc / 2;
+                    spaceAcc += vioCPs.size();
+                    auto mm = std::minmax_element(vioCPs.begin(), vioCPs.end());
+                    emit("space_ww", name, wireBox(l, t, *mm.first, *mm.second), n);
+                }
+            }
+        }
+    }
+    for (int l = 0; l + 1 < getLayerNum(); ++l) {
+        const std::string& name = getCutLayer(l).name;
+        int sameAcc = 0;
+        for (int t = 0; t < layers[l].numTracks(); ++t) {
+            for (const std::pair<int, int>& p : routedViaMap[l][t]) {
+                GridPoint via(l, t, p.first);
+                const ViaType* viaType = getViaType(via);
+                auto loc = getLoc(via);
+                auto cut = viaType->cut, bot = viaType->bot, top = viaType->top;
+                cut.ShiftBy(loc);
+                bot.ShiftBy(loc);
+                top.ShiftBy(loc);
+                int same = getViaUsageOnSameLayerVias(via, p.second, viaType);
+                emit("viavia_same", name, cut, (sameAcc + same) / 2 - sameAcc / 2);
+                sameAcc += same;
+                emit("viavia_top", name, top, getViaUsageOnTopLayerVias(via, p.second, viaType));
+                emit("viawire_bot", name, bot, getViaUsageOnBotWires(via, p.second, viaType));
+                emit("viawire_top", name, top, getViaUsageOnTopWires(via, p.second, viaType));
+                if (getViaPoorness(via, p.second) == ViaPoorness::Poor) emit("viafixed", name, cut);
+            }
+        }
+    }
+    for (const auto& lb : routeStat.minAreaVios) emit("minarea", getLayer(lb.first).name, lb.second);
+    std::ostringstream oss;
+    for (const auto& r : rows) oss << " " << r.first << "=" << r.second;
+    log() << "DRCU_VIO_DUMP " << path << " rows:" << oss.str() << std::endl;
+}
